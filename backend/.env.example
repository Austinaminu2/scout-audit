# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soroban_audit_prep
DB_USER=postgres
DB_PASSWORD=password

# JWT — required, the server refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# CLI Path (if not in PATH). Points at the locally built binary by
# default — run `cargo build --release` in cli/ first, or replace with
# `audit-prep` once it's installed onto PATH.
AUDIT_PREP_CLI_PATH=../cli/target/release/audit-prep
